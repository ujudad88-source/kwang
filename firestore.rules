rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == 'FEa3XBOSPMcEUumBo0aJrYkdvl12';
    }

    match /settings/{settingId} {
      // 로그인한 직원은 관리자가 지정한 화면 빌드를 읽을 수 있고, 지정 관리자만 변경할 수 있습니다.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /employeeAccess/{credentialHash} {
      // 직원 로그인은 해시 문서 한 건만 직접 조회합니다. 목록 조회는 관리자만 허용합니다.
      allow get: if signedIn();
      allow list, create, update, delete: if isAdmin();
    }

    // 이후 자재·단가·공지·도면 컬렉션을 단계적으로 추가합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
